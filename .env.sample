# Postgres (pgvector) credentials used by docker-compose.yml
DB_DATABASE=multimodal_vector_search
DB_USERNAME=mvs
DB_PASSWORD={your-password-here}
DB_PORT=5432

# PgAdmin web UI login (separate from the database credentials above)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD={your-password-here}

# Maximum vector distance, depending on the application you might want to manually tune this value:
# - Lower: finds more results even if less relevant
# - Higher: fids less results, they need to be more relevant
SEARCH_MAX_DISTANCE=0.35

# Allows to choose if to run the model locally or on google's own cloud platform
# If set to false make sure to add a gemini api key, you can create one at https://aistudio.google.com/apikey
RUN_VECTOR_MODEL_LOCALLY=true
GEMINI_API_KEY={your-api-key}
